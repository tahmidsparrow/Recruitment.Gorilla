# Copy to `.env.e2e` (same folder) and fill in real values. `.env.e2e` is
# gitignored; this .example file is tracked and must only ever hold placeholders.
#
# playwright.config.ts loads `.env.e2e` automatically, so `npm run e2e` works
# with no env prefixes once it exists.

# The account the smoke test signs in as. It must be:
#   - Recruiter, Admin or SuperAdmin — the test asserts the "Candidates" nav
#     link is visible, and navRoutes.ts gates that on canWriteCandidates.
#   - Active — an inactive account is rejected at login.
#   - Past its first-login password change — mustChangePassword redirects to
#     /change-password, so the nav link never appears.
E2E_EMAIL=recruiter@example.com
E2E_PASSWORD=<the account password>

# ---------------------------------------------------------------------------
# Other local test accounts worth keeping a note of. Record what each one is
# FOR, not just how to log in — an account whose purpose nobody remembers ends
# up deactivated and mysterious.
#
# Example of the shape (fill in your own):
#
#   demo.recruiter@rg.local     Recruiter    — role-scoping checks
#   demo.intv.a@rg.local        Interviewer  — peer-evaluation visibility, A of a pair
#   demo.intv.b@rg.local        Interviewer  — peer-evaluation visibility, B of a pair
#
# Passwords belong beside them in `.env.e2e`, never here.
