# Local dev default — Gorilla.IAM's own dev port (see gorilla-platform/iam/README.md).
# Not used in the container build; that wiring is gateway integration (P2 increment 4).
VITE_IAM_AUTHORITY=http://localhost:8100

# Backend the Vite dev proxy forwards /api to. Override per machine in
# .env.development.local (gitignored) if your API listens on another port.
# Keep it on localhost — the backend must not be reachable from the LAN.
VITE_API_PROXY_TARGET=http://localhost:5000
